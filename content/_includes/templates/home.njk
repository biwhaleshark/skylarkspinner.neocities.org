<!DOCTYPE html>
<html lang="en-US">
  <head>{% include 'blocks/head.njk' %}</head>

  <body>
    <a href="#main" id="skip-to-main">Skip to main</a>

    <header class="wrap">{% include 'blocks/header.njk' %}</header>
  
    <div class="primary-container wrap">
  
      <div id="sidebarA" class="container sidebar">{% include 'blocks/sidebarA.njk' %}</div>
      <div id="sidebarB" class="container sidebar">{% include 'blocks/sidebarB.njk' %}</div>
        
      <main id="main" class="container">
        {{ content | safe }}
      </main>
        
      <img alt="Drawing of ancient Egypt landscape." id="masthead">
      
    </div> <!-- End of Primary Container -->
  </body>
  
  <footer class="wrap">{% include 'blocks/footer.njk' %}</footer>
  
</html>
