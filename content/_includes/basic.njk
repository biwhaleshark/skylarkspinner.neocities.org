<!DOCTYPE html>
<html lang="en-US">
  <head>
    <title>{{ title }}</title>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="{{ nesting }}/img/favicon.ico">
    
    <script src="{{ nesting }}/assets/main.js"></script>
    <link rel="stylesheet" href="{{ nesting }}/assets/main.css" />
  </head>

  <body>
    <a href="#main" id="skip-to-main">Skip to main</a>

    <header id="header-container" class="wrap"></header>
  
    <div class="primary-container wrap">
  
      <div id="sidebar1-container" class="container sidebar"></div>
      <div id="sidebar2-container" class="container sidebar"></div>
        
      <main id="main" class="container">
        {{ content | safe }}
      </main>
        
      <img id="masthead">
      
    </div> <!-- End of Primary Container -->
  </body>
  
  <footer id="footer-container" class="wrap"></footer>
  
</html>
